# 지하철 분실물 알림 서비스 환경변수 예시
# ── DB (MySQL 8.4) ───────────────────────────────
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ── 메일 (Gmail SMTP) ────────────────────────────
# Gmail 계정 비밀번호가 아니라 앱 비밀번호를 넣는다
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 외부 API (경찰청 포털기관 습득물정보 조회 서비스) ──
POLICE_API_KEY=

# ── 서비스 주소 (메일 속 관리 링크에 사용) ──────────
APP_BASE_URL=
